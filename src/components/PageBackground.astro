---
import { backgroundConfig } from '../config';
const { enabled, image, opacity } = backgroundConfig;
---
{enabled && image && <div id="page-background" aria-hidden="true" style={`--background-opacity: ${opacity / 100}`}>
  <img src={image} alt="" decoding="async" />
</div>}
<style>
  #page-background { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; background: var(--page-bg); }
  img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: var(--background-opacity); }
  #page-background::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, transparent, color-mix(in srgb, var(--page-bg) 40%, transparent)); }
  :global(.dark) img { opacity: calc(var(--background-opacity) * .65); }
  @media (max-width: 767px) { img { object-position: 58% center; } }
</style>
