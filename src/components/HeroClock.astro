<hero-clock class="hero-clock" aria-label="当前北京时间" hidden>
  <span class="clock-caption">北京时间 <span aria-hidden="true">·</span> BEIJING</span>
  <time class="clock-time"></time>
  <span class="clock-rule" aria-hidden="true"></span>
  <span class="clock-date"></span>
</hero-clock>
<style>
  .hero-clock {
    position: absolute; top: max(7svh, env(safe-area-inset-top)); right: max(7vw, calc((100vw - 1168px) / 2));
    display: flex; flex-direction: column; align-items: flex-end; color: white; text-align: right;
    opacity: var(--hero-title-opacity, 1); transform: translateY(var(--hero-title-shift, 0px));
    text-shadow: 0 2px 12px rgb(8 16 30 / 85%), 0 0 28px rgb(8 16 30 / 45%);
  }
  .hero-clock[hidden] { display: none; }
  .clock-caption { font-size: .65rem; letter-spacing: .24em; }
  .clock-caption span { padding: 0 .5em; color: oklch(.86 .08 var(--hue)); }
  .clock-time { font-family: 'Baskerville', 'Palatino Linotype', 'Times New Roman', serif; font-size: clamp(2.5rem, 4.6vw, 4.75rem); font-style: italic; font-variant-numeric: tabular-nums; letter-spacing: .045em; line-height: 1.25; margin-top: .15em; white-space: nowrap; }
  .clock-rule { width: 3.5rem; height: 1px; margin: .6rem 0 .8rem; background: linear-gradient(90deg, transparent, oklch(.86 .08 var(--hue))); }
  .clock-date { font-family: 'STKaiti', 'KaiTi', 'Kaiti SC', serif; font-size: clamp(.9rem, 1.3vw, 1.15rem); letter-spacing: .12em; white-space: nowrap; }
  @media (max-width: 767px) { .hero-clock { top: max(6svh, env(safe-area-inset-top)); right: 7vw; } .clock-caption { font-size: .6rem; } }
  @media (max-height: 500px) and (orientation: landscape) { .hero-clock { top: 1.25rem; } .clock-time { font-size: 2.5rem; } }
</style>
<script>
  // A custom element owns one timer, including when Swup re-executes page scripts.
  if (!customElements.get('hero-clock')) {
    customElements.define('hero-clock', class extends HTMLElement {
      timer?: ReturnType<typeof setInterval>;
      timeFormat = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
      dateFormat = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
      update = () => {
        const now = new Date();
        const time = this.querySelector('time');
        const date = this.querySelector('.clock-date');
        if (!time || !date) return;
        time.textContent = this.timeFormat.format(now);
        time.dateTime = now.toISOString();
        date.textContent = this.dateFormat.format(now);
        this.hidden = false;
      };
      sync = () => {
        clearInterval(this.timer);
        if (!document.hidden) { this.update(); this.timer = setInterval(this.update, 1000); }
      };
      connectedCallback() { this.sync(); document.addEventListener('visibilitychange', this.sync); }
      disconnectedCallback() { clearInterval(this.timer); document.removeEventListener('visibilitychange', this.sync); }
    });
  }
</script>
